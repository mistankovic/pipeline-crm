<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.pipelinecrm</groupId>
    <artifactId>pipelinecrm-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>application</artifactId>
  <name>PipelineCRM :: application</name>
  <description>Use-case interactors and ports. Depends on domain only.</description>

  <properties>
    <!-- CONSTITUTION.md section 4: the tightest duplication threshold applies here. -->
    <cpd.minimum.tokens>30</cpd.minimum.tokens>
    <!--
      TEMPORARY, Stage 0 only: no production code yet, so no JaCoCo report exists.
      Stage 3 implements the use cases and MUST delete these two lines.
    -->
    <crap.skip>true</crap.skip>
    <coverage.skip>true</coverage.skip>
    <pit.skip>true</pit.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.pipelinecrm</groupId>
      <artifactId>domain</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>application-depends-on-domain-only</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>*:*:*:*:compile</exclude>
                    <exclude>*:*:*:*:runtime</exclude>
                    <exclude>*:*:*:*:provided</exclude>
                  </excludes>
                  <includes>
                    <include>com.pipelinecrm:domain:*:*:compile</include>
                  </includes>
                  <message>The application module may depend on com.pipelinecrm:domain and nothing else.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
