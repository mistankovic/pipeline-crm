<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
  Every suppression here needs a written reason. Unexplained suppressions are rejected
  at the review gate.
-->
<suppressions>
  <!--
    Spring instantiates the @SpringBootApplication class as a configuration bean and
    proxies it with CGLIB, so it cannot have a private constructor. Checkstyle sees a
    class whose only method is static main and calls it a utility class. It is not one:
    it is the composition root. Scoped to that single file.
  -->
  <suppress checks="HideUtilityClassConstructor" files="PipelineCrmApplication\.java$"/>
  <!--
    F-0.7: test sources are now checked. Structural rules (complexity, nesting, method
    length, star imports, braces) apply to tests exactly as to production code, because
    tests are the larger half of this codebase. Four checks are lifted for tests only:

      MagicNumber      - a test's whole point is concrete example values.
      VisibilityModifier - JUnit fixtures are conventionally package-visible fields.
      HideUtilityClassConstructor - test data builders and Cucumber glue holders.
      AbbreviationAsWordInName - test names spell out domain acronyms deliberately.
  -->
  <suppress id="methodNameProduction" files="[\\/]src[\\/]test[\\/]"/>
  <suppress id="constantNameProduction" files="[\\/]src[\\/]test[\\/]"/>
  <suppress id="constantNameTest" files="[\\/]src[\\/]main[\\/]"/>
  <suppress id="methodNameTest" files="[\\/]src[\\/]main[\\/]"/>
  <suppress checks="MagicNumber" files="[\\/]src[\\/]test[\\/]"/>
  <suppress checks="VisibilityModifier" files="[\\/]src[\\/]test[\\/]"/>
  <suppress checks="HideUtilityClassConstructor" files="[\\/]src[\\/]test[\\/]"/>
  <suppress checks="AbbreviationAsWordInName" files="[\\/]src[\\/]test[\\/]"/>
</suppressions>
