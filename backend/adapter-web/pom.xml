<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.pipelinecrm</groupId>
    <artifactId>pipelinecrm-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>adapter-web</artifactId>
  <name>PipelineCRM :: adapter-web</name>
  <description>Interface adapters for HTTP. Controllers translate HTTP to use-case ports and back.</description>

  <properties>
    <!--
      Opt-out, with reason. CONSTITUTION.md section 3 scopes the 95% coverage and CRAP
      gates to domain and application, which is where the business rules live. This
      module is an adapter: it is held to account by integration tests against a real
      HTTP surface and by the architecture fitness functions, not by a line-coverage number.
      Checkstyle, CPD and the architecture rules still apply in full.
    -->
    <coverage.skip>true</coverage.skip>
    <crap.skip>true</crap.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.pipelinecrm</groupId>
      <artifactId>application</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
